# Cloudflare Turnstile
# Public site key used by browser widgets.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<cloudflare-turnstile-site-key>

# Server-only secret used to validate each token.
TURNSTILE_SECRET_KEY=<cloudflare-turnstile-secret-key>

# Comma-separated hostnames accepted from Siteverify.
TURNSTILE_ALLOWED_HOSTNAMES=www.eazyvisas.com,eazyvisas.com

# Generate at least 32 random characters. Never expose this in client code.
RATE_LIMIT_HASH_SECRET=<generate-a-random-secret-with-at-least-32-characters>

# Existing MongoDB connection used by newsletter storage and form throttling.
MONGODB_URI=<mongodb-connection-string>
# Sanity Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=gdey5o8v
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2024-03-13

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.eazyvisas.com

# Webhook Security (Optional but recommended)
# Generate a secure random string for webhook authentication
SANITY_WEBHOOK_SECRET=your-secure-webhook-secret-token

# Database Configuration (if using MongoDB)
MONGODB_URI=your-mongodb-connection-string

# Email Configuration (if using Nodemailer)
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587